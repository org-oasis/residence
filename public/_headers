# Cache static assets for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images for 1 year
*.avif
*.webp
*.png
*.jpg
*.jpeg
*.gif
*.svg
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS files for 1 year
*.css
*.js
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts for 1 year
*.woff
*.woff2
*.ttf
*.eot
  Cache-Control: public, max-age=31536000, immutable

# HTML files - cache for 1 hour
*.html
  Cache-Control: public, max-age=3600

# Default cache + security headers for other files.
#
# NOTE: GitHub Pages (current host) does NOT process this file. Nothing below
# is served today — treat it as the reference configuration for a future
# migration to Netlify / Cloudflare Pages (both honor `_headers`) or as the
# spec to replicate on an edge/CDN. Until then the site ships with no security
# headers at all; do not count on this file for protection.
#
# CSP notes, should it ever be applied:
#   - 'unsafe-inline' on style-src is required by Tailwind/React inline styles.
#   - connect-src covers Supabase (REST + realtime over wss).
#   - frame-src covers the Google Maps embed on the contact page.
#   - Every font, image and script is self-hosted, hence 'self' elsewhere.
#   Verify against the console after any change: a wrong CSP breaks the site
#   silently for visitors.
/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://www.google.com; manifest-src 'self'; upgrade-insecure-requests
